# Copy this file to .env.development. Keep secrets in that file.
PUBLIC_BASE_URL=http://localhost:8787
FRONTEND_BASE_URL=http://localhost:6969
BROWSER_SESSION_TTL_SECONDS=604800
LOG_LEVEL=debug

# Local Neo4j. npm run db:dev uses these settings.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Add this redirect URI to the Google OAuth client:
# http://localhost:8787/google/callback
