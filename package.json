{
  "name": "mentis-4j",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts src",
    "format": "prettier --check 'src/**/*.ts' 'tests/**/*.js' package.json .eslintrc.json wrangler.jsonc",
    "test": "npm run build && node --test tests/*.test.js",
    "start": "node dist/process/server.js",
    "worker:build": "wrangler deploy --dry-run",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "neo4j-driver": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "wrangler": "^4.141.0"
  }
}
