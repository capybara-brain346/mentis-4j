{
  "name": "mentis-4j",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "npm run build && node --test tests/*.test.js",
    "start": "node dist/mcp/process/server.js",
    "worker:build": "wrangler deploy --dry-run",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "neo4j-driver": "^6.2.0",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.4",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "wrangler": "^4.141.0"
  }
}
